FUNCTION_BLOCK "RC_GoHome"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Execute : Bool;
   END_VAR

   VAR_OUTPUT 
      Busy : Bool;
      Done : Bool;
      Error : Bool;
      ErrorId : Int;
   END_VAR

   VAR_IN_OUT 
      Robot : "ST_ROBOT";
   END_VAR

   VAR 
      iStage : Int;
      iRC_CallProgramm { S7_SetPoint := 'False'} : "RC_CallProgram";
      xGo { S7_SetPoint := 'True'} : Bool;
   END_VAR


BEGIN
	// =============================================================================
	// Octopus Automation
	// (C) 2026
	// =============================================================================
	// Project: Template
	// 
	// POU: RC_GoHome
	// -----------------------------------------------------------------------------
	// Date         Version                        Author               Modification
	// 23.09.26                                    AM                Created               
	// =============================================================================
	
	// =============================================================================
	// Parameters:
	// 
	// =============================================================================
	
	IF "GVL".xKillAll THEN
	    #Busy := FALSE;
	    #Done := FALSE;
	    #Error := FALSE;
	    #ErrorId := 0;
	    #iStage := 0;
	    #Robot.SEND.CMD := 0;
	END_IF;
	
	#iRC_CallProgramm(Execute := #xGo,
	                  Robot := #Robot,
	                  Cmd := "ROBOT_CMD_GO_HOME",
	                  Param_1 := 0,
	                  Param_2 := 0,
	                  Param_3 := 0,
	                  Param_4 := 0,
	                  Param_5:=0,
	                  Param_6:=0);
	
	CASE #iStage OF
	        
	    0:
	        #Busy := FALSE;
	        #xGo := false;
	        // Wait for execute
	        IF #Execute THEN
	            #iStage := 10;
	        END_IF;
	        
	    10:
	        #Busy := true;
	        #Done := false;
	        #Error := false;
	        #xGo := true;
	        IF #iRC_CallProgramm.Busy THEN
	            #iStage := 20;
	        END_IF;
	        
	    20:
	        IF #iRC_CallProgramm.Done THEN
	            #iStage := 30;
	        END_IF;
	        IF #iRC_CallProgramm.Error THEN
	            #iStage := 1000;
	        END_IF;
	        
	    30:
	        #Done := true;
	        IF NOT #Execute THEN
	            #iStage := 0;
	        END_IF;
	       
	    1000:
	        #Error := true;
	        #ErrorId := #iRC_CallProgramm.ErrorId;
	        IF NOT #Execute THEN
	            #iStage := 0;
	        END_IF;
	        
	END_CASE;
	
	
END_FUNCTION_BLOCK

