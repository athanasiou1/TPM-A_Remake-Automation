	"ByteOUT :1 R3".%X7 := #ROBOT.SEND.AUTOBACKUP;
	
	// System byte 2; bits 0..7 follow the supplied robot mapping.
	"ByteOUT :2 R3".%X0 := #ROBOT.SEND.WORKPROHIBIT_R1;
