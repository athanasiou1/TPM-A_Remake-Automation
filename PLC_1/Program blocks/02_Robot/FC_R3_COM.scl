	//The following setup is made according to robot setup as slave ;
	// System byte 0; bits 0..7 follow the supplied robot mapping.
	"ByteOUT :0 R3".%X0 := #ROBOT.SEND.EXTERNALSTART;
	"ByteOUT :0 R3".%X1 := #ROBOT.SEND.EXTERNALSERVOON;
	"ByteOUT :0 R3".%X2 := #ROBOT.SEND.CALLMASTERJOB;
