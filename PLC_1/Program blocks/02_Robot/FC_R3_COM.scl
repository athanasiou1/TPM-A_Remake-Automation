	"ByteOUT :0 R3".%X5 := #ROBOT.SEND.BUZZER;
	"ByteOUT :0 R3".%X6 := #ROBOT.SEND.WATCHDOG;
	"ByteOUT :0 R3".%X7 := #ROBOT.SEND.LOWAIRPRESSURE;
	
	// System byte 1; bits 0..7 follow the supplied robot mapping.
	"ByteOUT :1 R3".%X0 := #ROBOT.SEND.MACHINELOCK;
	"ByteOUT :1 R3".%X1 := FALSE; // Reserved system bit.
	"ByteOUT :1 R3".%X2 := #ROBOT.SEND.EXTERNALHOLD;
	"ByteOUT :1 R3".%X3 := #ROBOT.SEND.INVALIDCOLLISIONDETECT;
	"ByteOUT :1 R3".%X4 := #ROBOT.SEND.CONTINUOUSCYCLESELECT;
